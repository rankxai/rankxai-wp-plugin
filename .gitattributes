# LF in the repository and in every working copy, on every platform.
#
# Not cosmetic. WordPress coding standards enforce LF (Generic.Files.LineEndings),
# so without this a Windows clone gets CRLF, PHPCS fails locally on files that are
# correct in the repository, and the person who cloned it "fixes" the wrong thing.
* text=auto eol=lf

# Never shipped in the WordPress.org release, and never counted in a language stat.
/.github/            export-ignore
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.editorconfig       export-ignore
/.wp-env.json        export-ignore
/phpcs.xml.dist      export-ignore
/composer.json       export-ignore
/composer.lock       export-ignore
/SECURITY.md         export-ignore
/probe/             export-ignore
/build-zip.mjs      export-ignore
/check.sh           export-ignore
